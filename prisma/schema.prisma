generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model companies {
  id                 Int                  @id @default(autoincrement())
  company_code       String               @unique @db.VarChar(20)
  company_name       String               @db.VarChar(150)
  owner_name         String?              @db.VarChar(100)
  phone              String?              @db.VarChar(20)
  email              String?              @db.VarChar(100)
  gst_number         String?              @db.VarChar(20)
  address            String?
  city               String?              @db.VarChar(50)
  state              String?              @db.VarChar(50)
  pincode            String?              @db.VarChar(10)
  industry_type      String?              @db.VarChar(50)
  subscription_plan  String?              @default("FREE") @db.VarChar(30)
  status             String?              @default("ACTIVE") @db.VarChar(20)
  entity_type        String?              @db.VarChar(50)
  pan_card           String?              @db.VarChar(10)
  employee_count     String?              @db.VarChar(20)
  founded_year       Int?
  secondary_email    String?              @db.VarChar(100)
  website            String?              @db.VarChar(150)
  onboarding_status  String?              @default("pending") @db.VarChar(20)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  expense_categories expense_categories[]
  expenses           expenses[]
  company_categories company_categories[]
  product_categories product_categories[]
  units              units[]
  products           products[]
  employees          employees[]
  customers          customers[]
  sales              sales[]
  permissions        permissions[]
}

model users {
  id              Int               @id @default(autoincrement())
  email           String            @unique @db.VarChar(150)
  password_hash   String            @db.VarChar(255)
  pin_hash        String?           @db.VarChar(255)
  role            String            @default("user") @db.VarChar(20)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  refresh_tokens  refresh_tokens[]
  password_resets password_resets[]
}

model password_resets {
  id               Int       @id @default(autoincrement())
  user_id          Int
  otp_hash         String    @db.VarChar(255)
  otp_expires_at   DateTime  @db.Timestamp(6)
  reset_token_hash String?   @db.VarChar(255)
  token_expires_at DateTime? @db.Timestamp(6)
  consumed_at      DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model expense_categories {
  id          String     @id @db.VarChar(16)
  company_id  Int
  companies   companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String     @db.VarChar(150)
  description String?
  status      String?    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  expenses    expenses[]
}

model expenses {
  id                 String             @id @db.VarChar(16)
  company_id         Int
  companies          companies          @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category_id        String
  expense_categories expense_categories @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unit_id            String?
  units              units?             @relation(fields: [unit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  title              String             @db.VarChar(200)
  amount             Decimal            @db.Decimal(12, 2)
  expense_date       DateTime?          @db.Date
  payment_method     String?            @db.VarChar(30)
  receipt_url        String?
  notes              String?
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  updated_at         DateTime?          @default(now()) @db.Timestamp(6)
}

model company_categories {
  id          String    @id @db.VarChar(16)
  company_id  Int
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String    @db.VarChar(150)
  description String?
  status      String?   @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model product_categories {
  id          String     @id @db.VarChar(16)
  company_id  Int
  companies   companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String     @db.VarChar(150)
  description String?
  status      String?    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  products    products[]
}

model units {
  id          String     @id @db.VarChar(16)
  company_id  Int
  companies   companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unit        String     @db.VarChar(20)
  full_form   String?    @db.VarChar(100)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  expenses    expenses[]
  products    products[]

  @@unique([company_id, unit])
}

model products {
  id                 String              @id @db.VarChar(16)
  company_id         Int
  companies          companies           @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_name       String              @db.VarChar(200)
  category_id        String?
  product_categories product_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  gender             String              @db.VarChar(20)
  design_pattern     String?             @db.VarChar(100)
  unit_id            String?
  units              units?              @relation(fields: [unit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  color              String?             @db.VarChar(50)
  size               String?             @db.VarChar(50)
  cost_price         Decimal?            @db.Decimal(12, 2)
  retail_price       Decimal?            @db.Decimal(12, 2)
  wholesale_price    Decimal?            @db.Decimal(12, 2)
  gallery_urls       String[]
  status             String?             @default("Active") @db.VarChar(20)
  onboarding_status  String?             @default("pending") @db.VarChar(20)
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  updated_at         DateTime?           @default(now()) @db.Timestamp(6)
}

model employees {
  id                      Int         @id @default(autoincrement())
  company_id              Int
  companies               companies   @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee_code           String?     @db.VarChar(20)
  first_name              String      @db.VarChar(100)
  last_name               String?     @db.VarChar(100)
  gender                  String?     @db.VarChar(20)
  date_of_birth           DateTime?   @db.Date
  email                   String?     @db.VarChar(150)
  phone                   String?     @db.VarChar(20)
  address                 String?
  joining_date            DateTime?   @db.Date
  department              String?     @db.VarChar(100)
  designation             String?     @db.VarChar(100)
  manager_id              Int?
  manager                 employees?  @relation("EmployeeManager", fields: [manager_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reports                 employees[] @relation("EmployeeManager")
  employment_type         String?     @db.VarChar(30)
  salary                  Decimal?    @db.Decimal(12, 2)
  pan_number              String?     @db.VarChar(10)
  aadhaar_number          String?     @db.VarChar(20)
  bank_name               String?     @db.VarChar(100)
  account_number          String?     @db.VarChar(30)
  ifsc_code               String?     @db.VarChar(15)
  emergency_contact_name  String?     @db.VarChar(100)
  emergency_contact_phone String?     @db.VarChar(20)
  status                  String?     @default("Active") @db.VarChar(20)
  onboarding_status       String?     @default("pending") @db.VarChar(20)
  created_at              DateTime?   @default(now()) @db.Timestamp(6)

  @@unique([company_id, employee_code])
}

model customers {
  id         String    @id @db.VarChar(16)
  company_id Int
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name       String    @db.VarChar(150)
  shop_name  String?   @db.VarChar(150)
  phone      String?   @db.VarChar(20)
  email      String?   @db.VarChar(150)
  gst_number String?   @db.VarChar(20)
  address    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  sales      sales[]
}

model sales {
  id             String     @id @db.VarChar(16)
  company_id     Int
  companies      companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bill_date      DateTime?  @db.Date
  customer_id    String?
  customers      customers? @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invoice_type   String?    @db.VarChar(30)
  bill_image_url String?
  subtotal       Decimal    @db.Decimal(12, 2)
  tax_amount     Decimal?   @default(0) @db.Decimal(12, 2)
  total_amount   Decimal?   @db.Decimal(12, 2)
  payment_type   String?    @db.VarChar(30)
  payment_status String     @default("Pending") @db.VarChar(20)
  notes          String?
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  updated_at     DateTime?  @default(now()) @db.Timestamp(6)
}

model modules {
  id          String        @id @db.VarChar(16)
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(200)
  parent_id   String?
  parent      modules?      @relation("ModuleParent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children    modules[]     @relation("ModuleParent")
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  updated_at  DateTime?     @default(now()) @db.Timestamp(6)
  permissions permissions[]
}

model permissions {
  id         String    @id @db.VarChar(16)
  company_id Int
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  module_id  String
  modules    modules   @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  view       Boolean   @default(false)
  create     Boolean   @default(false)
  edit       Boolean   @default(false)
  delete     Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([company_id, module_id])
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
