generator client {
  provider = "prisma-client-js"
}

// Neon: DATABASE_URL is the pooled connection (host has "-pooler") the app
// uses; DIRECT_URL is the direct one Prisma CLI needs for schema changes
// (db push / migrate). Both must point at the same database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model companies {
  id                      Int                            @id @default(autoincrement())
  deleted_at              DateTime?                      @db.Timestamp(6)
  company_code            String                         @unique @db.VarChar(20)
  company_name            String                         @db.VarChar(150)
  owner_name              String?                        @db.VarChar(100)
  phone                   String?                        @db.VarChar(20)
  email                   String?                        @db.VarChar(100)
  gst_number              String?                        @db.VarChar(20)
  address                 String?
  city                    String?                        @db.VarChar(50)
  state                   String?                        @db.VarChar(50)
  pincode                 String?                        @db.VarChar(10)
  industry_type           String?                        @db.VarChar(50)
  subscription_plan       String?                        @default("FREE") @db.VarChar(30)
  status                  String?                        @default("INACTIVE") @db.VarChar(20)
  user_type               String?                        @default("company") @db.VarChar(20)
  password                String?                        @db.VarChar(20)
  entity_type             String?                        @db.VarChar(50)
  pan_card                String?                        @db.VarChar(10)
  employee_count          String?                        @db.VarChar(20)
  founded_year            Int?
  secondary_email         String?                        @db.VarChar(100)
  website                 String?                        @db.VarChar(150)
  country                 String?                        @db.VarChar(60)
  company_category_id     String?                        @db.VarChar(30)
  company_category_name   String?                        @db.VarChar(100)
  logo_url                String?
  gallery_urls            String[]                       @default([])
  onboarding_status       String?                        @default("pending") @db.VarChar(20)
  // IANA time zone for this company's working day (attendance dates and
  // times), e.g. "Asia/Kolkata".
  timezone                String                         @default("Asia/Kolkata") @db.VarChar(64)
  created_at              DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                      @default(now()) @updatedAt @db.Timestamp(6)
  expense_categories      expense_categories[]
  expenses                expenses[]
  company_categories      company_categories[]
  product_categories      product_categories[]
  purchase_categories     purchase_categories[]
  units                   units[]
  products                products[]
  employees               employees[]
  customers               customers[]
  sales                   sales[]
  permissions             permissions[]
  users                   users[]
  support_tickets         support_tickets[]
  notifications           notifications[]
  chat_conversation       chat_conversations?
  push_recipients         push_notification_recipients[]
  announcement_views      announcement_views[]
  device_tokens           device_tokens[]
  sale_items              sale_items[]
  support_ticket_messages support_ticket_messages[]
  chat_messages           chat_messages[]
  purchases               purchases[]
  departments             departments[]
  work_types              work_types[]
  attendance              attendance[]
  employee_permissions    employee_permissions[]
  payroll_runs            payroll_runs[]
  payslips                payslips[]
}

model users {
  id                   Int               @id @default(autoincrement())
  deleted_at           DateTime?         @db.Timestamp(6)
  company_id           Int?
  companies            companies?        @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email                String            @unique @db.VarChar(150)
  password_hash        String            @db.VarChar(255)
  pin_hash             String?           @db.VarChar(255)
  role                 String            @default("user") @db.VarChar(20)
  user_type            String?           @db.VarChar(20)
  // An employee's own login (user_type "employee"): which employee it is.
  // Set by the company admin from the employee's record.
  employee_id          Int?              @unique
  employees            employees?        @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // Signed in with an emailed temporary password: a new one must be set
  // before anything else (see session.middleware).
  must_change_password Boolean           @default(false)
  // The employee setup email: when it last went out, or why it failed.
  setup_email_sent_at  DateTime?         @db.Timestamp(6)
  setup_email_error    String?
  created_at           DateTime          @default(now()) @db.Timestamp(6)
  updated_at           DateTime          @default(now()) @db.Timestamp(6)
  refresh_tokens       refresh_tokens[]
  password_resets      password_resets[]
}

model password_resets {
  id               Int       @id @default(autoincrement())
  user_id          Int
  otp_hash         String    @db.VarChar(255)
  otp_expires_at   DateTime  @db.Timestamp(6)
  reset_token_hash String?   @db.VarChar(255)
  token_expires_at DateTime? @db.Timestamp(6)
  consumed_at      DateTime? @db.Timestamp(6)
  // "password" (forgot password) or "pin" (forgot app PIN). Every lookup filters
  // on it, so a code or reset token only works for its own flow.
  purpose          String    @default("password") @db.VarChar(10)
  // Wrong OTP guesses for this code; the code is dropped after the limit.
  attempts         Int       @default(0)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model expense_categories {
  id          String     @id @db.VarChar(16)
  deleted_at  DateTime?  @db.Timestamp(6)
  company_id  Int
  companies   companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String     @db.VarChar(150)
  description String?
  status      String?    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  expenses    expenses[]
}

model expenses {
  id                 String             @id @db.VarChar(16)
  company_id         Int
  companies          companies          @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category_id        String
  expense_categories expense_categories @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unit_id            String?
  units              units?             @relation(fields: [unit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  title              String             @db.VarChar(200)
  amount             Decimal            @db.Decimal(12, 2)
  expense_date       DateTime?          @db.Date
  payment_method     String?            @db.VarChar(30)
  receipt_url        String?
  notes              String?
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  updated_at         DateTime?          @default(now()) @db.Timestamp(6)
}

model company_categories {
  id          String     @id @db.VarChar(16)
  deleted_at  DateTime?  @db.Timestamp(6)
  // null = global master (the superadmin's list, not owned by a company).
  company_id  Int?
  companies   companies? @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String     @db.VarChar(150)
  description String?
  status      String?    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
}

model product_categories {
  id          String     @id @db.VarChar(16)
  deleted_at  DateTime?  @db.Timestamp(6)
  company_id  Int
  companies   companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String     @db.VarChar(150)
  description String?
  status      String?    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  products    products[]
}

// What a company buys to make its products (Elastic, Thread, Buttons), as
// opposed to product_categories, which group what it sells. Purchase bill
// lines pick one of these.
model purchase_categories {
  id             String           @id @db.VarChar(16)
  deleted_at     DateTime?        @db.Timestamp(6)
  company_id     Int
  companies      companies        @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name           String           @db.VarChar(150)
  description    String?
  status         String?          @default("ACTIVE") @db.VarChar(20)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  purchase_items purchase_items[]
}

model units {
  id          String     @id @db.VarChar(16)
  deleted_at  DateTime?  @db.Timestamp(6)
  company_id  Int
  companies   companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unit        String     @db.VarChar(20)
  full_form   String?    @db.VarChar(100)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  updated_at  DateTime?  @default(now()) @db.Timestamp(6)
  expenses    expenses[]
  products    products[]

  @@unique([company_id, unit])
}

model products {
  id                  String              @id @db.VarChar(16)
  deleted_at          DateTime?           @db.Timestamp(6)
  company_id          Int
  companies           companies           @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_name        String              @db.VarChar(200)
  // Readable code from the company and name, e.g. "C53-BILLASHORTS"; set by
  // the server when the product is created and never changed after. Each
  // size/colour's sku builds on it. See src/utils/productCode.js.
  product_code        String?             @db.VarChar(40)
  category_id         String?
  product_categories  product_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  gender              String              @db.VarChar(20)
  design_pattern      String?             @db.VarChar(100)
  unit_id             String?
  units               units?              @relation(fields: [unit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  color               String?             @db.VarChar(50)
  size                String?             @db.VarChar(50)
  cost_price          Decimal?            @db.Decimal(12, 2)
  retail_price        Decimal?            @db.Decimal(12, 2)
  wholesale_price     Decimal?            @db.Decimal(12, 2)
  // Units in stock: down on each sale line, back up when a sale is edited or deleted;
  // set/corrected through PUT /products/:id (there is no purchases module).
  stock_quantity      Int                 @default(0)
  // At or below this is "low stock" in reports.
  low_stock_threshold Int                 @default(5)
  gallery_urls        String[]
  status              String?             @default("Active") @db.VarChar(20)
  onboarding_status   String?             @default("pending") @db.VarChar(20)
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  updated_at          DateTime?           @default(now()) @db.Timestamp(6)
  sale_items          sale_items[]
  purchase_items      purchase_items[]
  stock_movements     stock_movements[]
  product_variants    product_variants[]

  @@unique([company_id, product_code])
}

// A size/colour of a product ("M / Blue"), with its own code, prices and
// stock. Optional: a product without variants keeps its stock and prices on
// the product itself. With variants, products.stock_quantity is the sum of
// its variants' stock (every change moves both — see inventory/stock.js).
model product_variants {
  id              String            @id @db.VarChar(16)
  deleted_at      DateTime?         @db.Timestamp(6)
  product_id      String
  products        products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id      Int
  size            String?           @db.VarChar(50)
  color           String?           @db.VarChar(50)
  // The size/colour's code, e.g. "C53-BILLASHORTS-S-BLUE": typed in, or
  // made by the server from the product code, size and colour when left
  // blank. Unique within the company.
  sku             String?           @db.VarChar(60)
  // Empty = use the product's price.
  cost_price      Decimal?          @db.Decimal(12, 2)
  retail_price    Decimal?          @db.Decimal(12, 2)
  wholesale_price Decimal?          @db.Decimal(12, 2)
  stock_quantity  Int               @default(0)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  sale_items      sale_items[]
  stock_movements stock_movements[]

  @@index([product_id])
  @@index([company_id, sku])
}

model employees {
  id                      Int                    @id @default(autoincrement())
  deleted_at              DateTime?              @db.Timestamp(6)
  company_id              Int
  companies               companies              @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee_code           String?                @db.VarChar(20)
  first_name              String                 @db.VarChar(100)
  last_name               String?                @db.VarChar(100)
  gender                  String?                @db.VarChar(20)
  date_of_birth           DateTime?              @db.Date
  email                   String?                @db.VarChar(150)
  phone                   String?                @db.VarChar(20)
  address                 String?
  joining_date            DateTime?              @db.Date
  // Free text from before the Department master; kept for older records.
  department              String?                @db.VarChar(100)
  department_id           String?                @db.VarChar(16)
  departments             departments?           @relation(fields: [department_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  designation             String?                @db.VarChar(100)
  manager_id              Int?
  manager                 employees?             @relation("EmployeeManager", fields: [manager_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reports                 employees[]            @relation("EmployeeManager")
  employment_type         String?                @db.VarChar(30)
  // SHIFT_RATE / HOURLY / WEEKLY / MONTHLY: paid `salary` per shift, hour,
  // week or month. PIECE_RATE: by each work type's rate, so `salary` is
  // unused. salary_period mirrors the type (see employees/salary.js). Null
  // on employees from before this.
  salary_type             String?                @db.VarChar(20)
  salary_period           String?                @db.VarChar(20)
  salary                  Decimal?               @db.Decimal(12, 2)
  pan_number              String?                @db.VarChar(10)
  aadhaar_number          String?                @db.VarChar(20)
  bank_name               String?                @db.VarChar(100)
  account_number          String?                @db.VarChar(30)
  ifsc_code               String?                @db.VarChar(15)
  emergency_contact_name  String?                @db.VarChar(100)
  emergency_contact_phone String?                @db.VarChar(20)
  status                  String?                @default("Active") @db.VarChar(20)
  onboarding_status       String?                @default("pending") @db.VarChar(20)
  user_type               String?                @default("employee") @db.VarChar(20)
  created_at              DateTime?              @default(now()) @db.Timestamp(6)
  users                   users?
  attendance              attendance[]
  employee_permissions    employee_permissions[]
  payslips                payslips[]

  @@unique([company_id, employee_code])
}

// Company departments (Masters), picked on an employee. Soft-deleted.
model departments {
  id          String      @id @db.VarChar(16)
  deleted_at  DateTime?   @db.Timestamp(6)
  company_id  Int
  companies   companies   @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String      @db.VarChar(150)
  description String?
  status      String?     @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  updated_at  DateTime?   @default(now()) @db.Timestamp(6)
  employees   employees[]
}

// Piece-rate work (Masters), e.g. "T-shirt neck stitching" at 300 a piece.
// Soft-deleted.
model work_types {
  id                String              @id @db.VarChar(16)
  deleted_at        DateTime?           @db.Timestamp(6)
  company_id        Int
  companies         companies           @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name              String              @db.VarChar(150)
  description       String?
  rate              Decimal             @db.Decimal(12, 2)
  status            String?             @default("ACTIVE") @db.VarChar(20)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  attendance_pieces attendance_pieces[]
}

// One employee's attendance for one day (the company's local date). Shift-
// rate employees record shifts, piece-rate employees record pieces. Deleted
// for real (not soft), so the one-per-day rule stays a plain unique index.
model attendance {
  id          String              @id @db.VarChar(16)
  company_id  Int
  companies   companies           @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee_id Int
  employees   employees           @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  work_date   DateTime            @db.Date
  // When it was recorded, and that moment in the company's time zone.
  recorded_at DateTime            @default(now()) @db.Timestamp(6)
  timezone    String              @db.VarChar(64)
  // The employee's salary type at the time (employees/salary.js).
  kind        String              @db.VarChar(20)
  // HOURLY: hours worked. WEEKLY / MONTHLY: 1 (full day) or 0.5 (half).
  hours       Decimal?            @db.Decimal(5, 2)
  day_units   Decimal?            @db.Decimal(3, 2)
  notes       String?
  recorded_by Int?
  created_at  DateTime?           @default(now()) @db.Timestamp(6)
  updated_at  DateTime?           @default(now()) @db.Timestamp(6)
  shifts      attendance_shifts[]
  pieces      attendance_pieces[]

  @@unique([employee_id, work_date])
  @@index([company_id, work_date])
}

// Up to three shifts in a day, each 0.25, 0.5, 0.75, 1, 2 or 3 shifts.
model attendance_shifts {
  id            String     @id @db.VarChar(16)
  attendance_id String     @db.VarChar(16)
  attendance    attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shift_no      Int
  units         Decimal    @db.Decimal(4, 2)

  @@unique([attendance_id, shift_no])
}

// Pieces done of one work type; the rate is kept as it was that day.
model attendance_pieces {
  id            String     @id @db.VarChar(16)
  attendance_id String     @db.VarChar(16)
  attendance    attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_type_id  String     @db.VarChar(16)
  work_types    work_types @relation(fields: [work_type_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quantity      Int
  rate          Decimal    @db.Decimal(12, 2)
  amount        Decimal    @db.Decimal(12, 2)

  @@unique([attendance_id, work_type_id])
}

model customers {
  id         String    @id @db.VarChar(16)
  deleted_at DateTime? @db.Timestamp(6)
  company_id Int
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name       String    @db.VarChar(150)
  shop_name  String?   @db.VarChar(150)
  phone      String?   @db.VarChar(20)
  email      String?   @db.VarChar(150)
  gst_number String?   @db.VarChar(20)
  address    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  sales      sales[]
}

model sales {
  id                 String       @id @db.VarChar(16)
  company_id         Int
  companies          companies    @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bill_date          DateTime?    @db.Date
  customer_id        String?
  customers          customers?   @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invoice_type       String?      @db.VarChar(30)
  bill_image_url     String?
  subtotal           Decimal      @db.Decimal(12, 2)
  tax_percentage     Decimal?     @default(0) @db.Decimal(5, 2)
  tax_amount         Decimal?     @default(0) @db.Decimal(12, 2)
  total_amount       Decimal?     @db.Decimal(12, 2)
  // Received so far; the balance is total_amount - amount_paid.
  amount_paid        Decimal      @default(0) @db.Decimal(12, 2)
  payment_type       String?      @db.VarChar(30)
  payment_status     String       @default("Pending") @db.VarChar(20)
  notes              String?
  // GST = tax invoice; SECONDARY = bill without GST (tax is always 0).
  // Fixed once the sale is created.
  bill_type          String       @default("GST") @db.VarChar(10)
  // A GST bill that can also be printed as a secondary bill (no GST).
  // Always false on a secondary bill.
  has_secondary_bill Boolean      @default(false)
  // Running number per company, bill type and financial year, set by the
  // server: "C7G2627/0001" (GST), "C7S2627/0001" (secondary). It carries the
  // company id, so it's unique across all companies. Null on older sales.
  bill_no            String?      @unique @db.VarChar(30)
  created_at         DateTime?    @default(now()) @db.Timestamp(6)
  updated_at         DateTime?    @default(now()) @db.Timestamp(6)
  sale_items         sale_items[]
}

model sale_items {
  id               String            @id @db.VarChar(16)
  sale_id          String
  sales            sales             @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id       Int?
  companies        companies?        @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_id       String
  products         products          @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_name     String            @db.VarChar(200)
  // The size/colour sold, when the product has variants.
  variant_id       String?
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // "M / Blue" when the line was saved.
  variant_label    String?           @db.VarChar(110)
  price_type       String            @db.VarChar(20)
  price            Decimal           @db.Decimal(12, 2)
  quantity         Int
  line_total       Decimal           @db.Decimal(12, 2)
  // The product's cost_price when the line was saved, so past profit doesn't
  // change when the product's cost changes later.
  cost_price       Decimal?          @db.Decimal(12, 2)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)

  @@index([company_id])
}

model modules {
  id                    String                 @id @db.VarChar(16)
  name                  String                 @db.VarChar(100)
  description           String?                @db.VarChar(200)
  parent_id             String?
  parent                modules?               @relation("ModuleParent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children              modules[]              @relation("ModuleParent")
  visible_to_superadmin Boolean                @default(true)
  always_visible        Boolean                @default(false)
  // false = superadmin-only (Companies, Permissions, Company Category): never
  // offered on the company Permissions screen.
  grantable             Boolean                @default(true)
  created_at            DateTime?              @default(now()) @db.Timestamp(6)
  updated_at            DateTime?              @default(now()) @db.Timestamp(6)
  permissions           permissions[]
  employee_permissions  employee_permissions[]
}

model permissions {
  id         String    @id @db.VarChar(16)
  company_id Int
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  module_id  String
  modules    modules   @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  view       Boolean   @default(false)
  create     Boolean   @default(false)
  edit       Boolean   @default(false)
  delete     Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([company_id, module_id])
}

model support_tickets {
  id          String                    @id @db.VarChar(16)
  deleted_at  DateTime?                 @db.Timestamp(6)
  company_id  Int
  companies   companies                 @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subject     String                    @db.VarChar(200)
  description String
  category    String                    @default("other") @db.VarChar(20)
  priority    String                    @default("medium") @db.VarChar(20)
  status      String                    @default("open") @db.VarChar(20)
  raised_by   String?                   @db.VarChar(150)
  assigned_to String?                   @db.VarChar(150)
  created_at  DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at  DateTime?                 @default(now()) @updatedAt @db.Timestamp(6)
  // When it last became resolved/closed (null while open). Reports bucket
  // resolutions by this, not updated_at, which later edits move.
  resolved_at DateTime?                 @db.Timestamp(6)
  messages    support_ticket_messages[]
}

model support_ticket_messages {
  id               String          @id @db.VarChar(16)
  ticket_id        String
  support_tickets  support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id       Int?
  companies        companies?      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender_name      String          @db.VarChar(150)
  is_support_reply Boolean         @default(false)
  text             String
  sent_at          DateTime        @default(now()) @db.Timestamp(6)

  @@index([company_id])
}

model chat_conversations {
  id         Int             @id @default(autoincrement())
  deleted_at DateTime?       @db.Timestamp(6)
  company_id Int             @unique
  companies  companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_at DateTime        @default(now()) @db.Timestamp(6)
  messages   chat_messages[]
}

model chat_messages {
  id                 Int                @id @default(autoincrement())
  conversation_id    Int
  chat_conversations chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id         Int?
  companies          companies?         @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender_name        String             @db.VarChar(150)
  is_support         Boolean            @default(false)
  type               String             @default("text") @db.VarChar(10)
  text               String?
  attachment_url     String?
  duration_ms        Int?
  sent_at            DateTime           @default(now()) @db.Timestamp(6)

  @@index([conversation_id, id])
  @@index([company_id])
}

model notifications {
  id         String     @id @db.VarChar(16)
  company_id Int?
  companies  companies? @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type       String     @default("system") @db.VarChar(30)
  title      String     @db.VarChar(200)
  message    String
  is_read    Boolean    @default(false)
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  updated_at DateTime?  @default(now()) @db.Timestamp(6)
}

model push_notifications {
  id                  String                         @id @db.VarChar(16)
  title               String                         @db.VarChar(60)
  message             String                         @db.VarChar(250)
  audience            Json
  priority            String                         @default("normal") @db.VarChar(20)
  open_on_tap         String                         @default("none") @db.VarChar(30)
  specific_page_route String?
  status              String                         @default("draft") @db.VarChar(20)
  scheduled_at        DateTime?                      @db.Timestamp(6)
  sent_at             DateTime?                      @db.Timestamp(6)
  recipients          Int                            @default(0)
  created_by          String?                        @db.VarChar(150)
  deleted_at          DateTime?                      @db.Timestamp(6)
  created_at          DateTime                       @default(now()) @db.Timestamp(6)
  updated_at          DateTime                       @default(now()) @updatedAt @db.Timestamp(6)
  deliveries          push_notification_recipients[]
}

model push_notification_recipients {
  id                 Int                @id @default(autoincrement())
  notification_id    String
  push_notifications push_notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id         Int
  companies          companies          @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status             String             @default("pending") @db.VarChar(10)
  error              String?
  delivered_at       DateTime?          @db.Timestamp(6)
  opened_at          DateTime?          @db.Timestamp(6)

  @@unique([notification_id, company_id])
}

model device_tokens {
  id         Int       @id @default(autoincrement())
  company_id Int
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  token      String    @unique @db.VarChar(255)
  platform   String    @db.VarChar(20)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamp(6)
}

model announcements {
  id                  String               @id @db.VarChar(16)
  deleted_at          DateTime?            @db.Timestamp(6)
  title               String               @db.VarChar(200)
  short_description   String?
  content             String               @default("")
  banner_url          String?
  audience            Json
  cta_label           String?              @db.VarChar(100)
  cta_target          String?              @db.VarChar(50)
  specific_page_route String?
  status              String               @default("draft") @db.VarChar(20)
  scheduled_at        DateTime?            @db.Timestamp(6)
  published_at        DateTime?            @db.Timestamp(6)
  created_by          String?              @db.VarChar(150)
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  announcement_views  announcement_views[]
}

model announcement_views {
  id              Int           @id @default(autoincrement())
  announcement_id String
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id      Int
  companies       companies     @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewed_at       DateTime      @default(now()) @db.Timestamp(6)

  @@unique([announcement_id, company_id])
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Audit trail for the superadmin dashboard's "Recent activity". Written
// best-effort by utils/activityLog.js; never blocks the action it records.
model activity_logs {
  id            Int      @id @default(autoincrement())
  type          String   @db.VarChar(40)
  title         String   @db.VarChar(150)
  detail        String?  @db.VarChar(300)
  ref_id        String?  @db.VarChar(50)
  actor_user_id Int?
  company_id    Int?
  created_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([created_at])
}

// ---------- Inventory ----------
// Stock comes in through purchases, goes out through sales, and is corrected
// by adjustments. products.stock_quantity is the live balance; every change
// also writes a stock_movements row (see src/modules/inventory/stock.js).

// A supplier bill (mirrors sales). Saving its lines adds to stock.
model purchases {
  id             String           @id @db.VarChar(16)
  company_id     Int
  companies      companies        @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier_name  String           @db.VarChar(150)
  bill_no        String?          @db.VarChar(50)
  bill_date      DateTime?        @db.Date
  invoice_type   String?          @db.VarChar(30)
  bill_image_url String?
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  tax_percentage Decimal?         @default(0) @db.Decimal(5, 2)
  tax_amount     Decimal          @default(0) @db.Decimal(12, 2)
  total_amount   Decimal          @default(0) @db.Decimal(12, 2)
  amount_paid    Decimal          @default(0) @db.Decimal(12, 2)
  payment_type   String?          @db.VarChar(30)
  payment_status String           @default("Pending") @db.VarChar(20)
  notes          String?
  created_by     Int?
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  purchase_items purchase_items[]

  @@index([company_id, bill_date])
}

model purchase_items {
  id                   String               @id @db.VarChar(16)
  purchase_id          String
  purchases            purchases            @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id           Int
  // A line is either a purchase category (raw material, no stock) or, on
  // older bills, a product (adds to its stock).
  purchase_category_id String?
  purchase_categories  purchase_categories? @relation(fields: [purchase_category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_id           String?
  products             products?            @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // The product's or purchase category's name when the line was saved.
  product_name         String               @db.VarChar(200)
  quantity             Int
  // What the quantity counts, e.g. "pcs", "m", "kg" (a Units master name).
  unit                 String?              @db.VarChar(20)
  unit_cost            Decimal              @db.Decimal(12, 2)
  line_total           Decimal              @db.Decimal(12, 2)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)

  @@index([purchase_id])
}

// The stock ledger: one row per change, append-only (fix a mistake with an
// opposite adjustment, never by editing a row).
model stock_movements {
  id               Int               @id @default(autoincrement())
  company_id       Int
  product_id       String
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // The size/colour whose stock moved (null for a product without variants).
  variant_id       String?
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // purchase | sale | adjustment
  type             String            @db.VarChar(20)
  // adjustments: opening | correction | damage | return | other
  reason           String?           @db.VarChar(30)
  // Signed change: +in, -out.
  quantity         Int
  balance_after    Int
  // The sale or purchase that caused it.
  reference_id     String?           @db.VarChar(20)
  note             String?           @db.VarChar(300)
  created_by       Int?
  created_at       DateTime          @default(now()) @db.Timestamp(6)

  @@index([company_id, product_id, created_at])
}

// What a company admin lets one employee do in each module. Only modules the
// company itself has, and never more than the company may (see
// permission.middleware): an employee's access is both rows together.
model employee_permissions {
  id          String    @id @db.VarChar(16)
  company_id  Int
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee_id Int
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  module_id   String    @db.VarChar(16)
  modules     modules   @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  view        Boolean   @default(false)
  create      Boolean   @default(false)
  edit        Boolean   @default(false)
  delete      Boolean   @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@unique([employee_id, module_id])
}

// One month's salary generation for a company: a payslip per employee,
// worked out from attendance. DRAFT while it's reviewed (additions and
// deductions can change, or it can be generated again); FINALIZED once
// confirmed -- then payslips can be sent and count in the salary report.
model payroll_runs {
  id           String     @id @db.VarChar(16)
  company_id   Int
  companies    companies  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // "2026-10"
  month        String     @db.VarChar(7)
  period_from  DateTime   @db.Date
  period_to    DateTime   @db.Date
  // A monthly salary is per these days (the month less its Sundays, unless
  // changed when generating).
  working_days Int
  status       String     @default("DRAFT") @db.VarChar(20)
  total_gross  Decimal    @default(0) @db.Decimal(14, 2)
  total_net    Decimal    @default(0) @db.Decimal(14, 2)
  created_by   Int?
  finalized_at DateTime?  @db.Timestamp(6)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @default(now()) @db.Timestamp(6)
  payslips     payslips[]

  @@unique([company_id, month])
}

// One employee's pay for a payroll run. [units] are shifts, pieces, hours
// or days, by [salary_type]; [rate] is the salary amount then (null for
// piece rate). net = gross + additions - deductions.
model payslips {
  id           String       @id @db.VarChar(16)
  run_id       String       @db.VarChar(16)
  payroll_runs payroll_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company_id   Int
  companies    companies    @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee_id  Int
  employees    employees    @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  salary_type  String       @db.VarChar(20)
  rate         Decimal?     @db.Decimal(12, 2)
  units        Decimal      @default(0) @db.Decimal(12, 2)
  days_present Decimal      @default(0) @db.Decimal(6, 2)
  gross        Decimal      @default(0) @db.Decimal(12, 2)
  additions    Decimal      @default(0) @db.Decimal(12, 2)
  deductions   Decimal      @default(0) @db.Decimal(12, 2)
  net          Decimal      @default(0) @db.Decimal(12, 2)
  // Piece rate: [{ work_type_id, name, quantity, rate, amount }].
  breakdown    Json?
  notes        String?
  emailed_at   DateTime?    @db.Timestamp(6)
  email_error  String?
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  updated_at   DateTime?    @default(now()) @db.Timestamp(6)

  @@unique([run_id, employee_id])
  @@index([employee_id])
}
