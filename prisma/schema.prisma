generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model companies {
  id                Int         @id @default(autoincrement())
  company_code      String      @unique @db.VarChar(20)
  company_name      String      @db.VarChar(150)
  owner_name        String?     @db.VarChar(100)
  phone             String?     @db.VarChar(20)
  email             String?     @db.VarChar(100)
  gst_number        String?     @db.VarChar(20)
  address           String?
  city              String?     @db.VarChar(50)
  state             String?     @db.VarChar(50)
  pincode           String?     @db.VarChar(10)
  industry_type     String?     @db.VarChar(50)
  subscription_plan String?     @default("basic") @db.VarChar(30)
  status            String?     @default("active") @db.VarChar(20)
  created_at        DateTime?   @default(now()) @db.Timestamp(6)
  updated_at        DateTime?   @default(now()) @db.Timestamp(6)
  entity_type       String      @default("Individual") @db.VarChar(50)
  pan_card          String?     @db.VarChar(10)
  customers         customers[]
  sales             sales[]
}

model customers {
  id                Int        @id @default(autoincrement())
  company_id        Int?
  customer_type     String?    @db.VarChar(20)
  customer_name     String?    @db.VarChar(100)
  business_name     String?    @db.VarChar(150)
  phone             String?    @db.VarChar(20)
  email             String?    @db.VarChar(100)
  gst_number        String?    @db.VarChar(20)
  address           String?
  city              String?    @db.VarChar(50)
  state             String?    @db.VarChar(50)
  created_at        DateTime?  @default(now()) @db.Timestamp(6)
  owner_name        String?    @db.VarChar(100)
  pincode           String?    @db.VarChar(10)
  industry_type     String?    @db.VarChar(50)
  subscription_plan String?    @db.VarChar(30)
  status            String?    @db.VarChar(20)
  updated_at        DateTime?  @db.Timestamp(6)
  entity_type       String?    @db.VarChar(50)
  pan_card          String?    @db.VarChar(20)
  companies         companies? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales             sales[]
}

model sales {
  id             Int        @id @default(autoincrement())
  company_id     Int?
  customer_id    Int?
  bill_no        String     @unique @db.VarChar(30)
  bill_date      DateTime   @db.Date
  invoice_type   String?    @db.VarChar(20)
  subtotal       Decimal?   @db.Decimal(12, 2)
  tax_amount     Decimal?   @default(0) @db.Decimal(12, 2)
  total_amount   Decimal?   @db.Decimal(12, 2)
  payment_type   String?    @db.VarChar(20)
  payment_status String?    @db.VarChar(20)
  notes          String?
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  companies      companies? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers      customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
