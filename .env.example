PORT=3000

# ── Database (Neon) ─────────────────────────────────────────────────────────
# One Neon project per environment: brixen-test for local work and the test
# server, brixen-prod for the live server only. Never put production URLs in
# your local .env.
#
# DATABASE_URL: the POOLED connection the app uses (host contains "-pooler").
# connect_timeout gives Neon time to wake from scale-to-zero.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DIRECT_URL: the DIRECT connection (same host without "-pooler"), used only
# by Prisma CLI schema commands (prisma db push / migrate / validate).
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Which database this is: test | production. The reset/wipe scripts in
# scripts/ treat anything other than "test" as production.
DB_ENV=test
# The production database's endpoint ID (the "ep-..." part of its host, no
# user or password). The reset/wipe scripts treat any URL containing it as
# production, even if DB_ENV says test. Set it in every local .env.
PRODUCTION_DB_ENDPOINT=

ADMIN_EMAIL=admin@brixen.com
ADMIN_PASSWORD=change-me

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=no-reply@brixen.store

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
