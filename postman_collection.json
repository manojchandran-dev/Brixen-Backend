            "url": {
              "raw": "{{baseUrl}}/api/v1/companies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "companies"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp\",\n  \"address\": \"123 Main St, Springfield\",\n  \"email\": \"contact@acme.com\",\n  \"phone\": \"+1-555-123-4567\"\n}"
            }
